{
  "name": "maxubrq",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "maxubrq — a notebook, kept in public. Ink edition.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && git config core.hooksPath .githooks",
    "drafts": "node scripts/drafts.mjs",
    "drafts:check": "node scripts/drafts.mjs --check",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/d3-force": "^3.0.10",
    "@types/d3-shape": "^3.1.8",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "github-slugger": "^2.0.0",
    "katex": "^0.13.24",
    "mdsvex": "^0.12.3",
    "minisearch": "^7.2.0",
    "rehype-katex": "^4.0.0",
    "rehype-slug": "^4.0.1",
    "remark-gfm": "^3.0.1",
    "remark-math": "^3.0.1",
    "svelte": "^5.2.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "d3-force": "^3.0.0",
    "d3-shape": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "hls.js": "^1.7.0",
    "postgres": "^3.4.9",
    "roughjs": "^4.6.6"
  }
}
