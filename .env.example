# Postgres. Pooled connection (pgbouncer, transaction mode) for the app…
DATABASE_URL=postgresql://user:pass@host:6543/postgres
# …and a direct one for migrations, which cannot run DDL over the pool.
DIRECT_URL=postgresql://user:pass@host:5432/postgres

# Basic-auth password for /api/signals. Username is `maxubrq`.
# Unset in production = the endpoint stays closed (503), never open.
SIGNAL_PASSWORD=
